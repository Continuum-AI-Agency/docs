{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Continuum",
  "description": "AI creative operations platform — plan, generate, publish, and optimize on-brand content across organic and paid channels.",
  "colors": {
    "primary": "#7C3AED",
    "light": "#A78BFA",
    "dark": "#5B21B6"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart",
              "concepts",
              "integrations"
            ]
          },
          {
            "group": "AI Studio",
            "pages": [
              "studio/overview",
              "studio/canvas",
              "studio/workflows",
              "studio/library",
              {
                "group": "After Effects delivery",
                "pages": [
                  "studio/after-effects/overview",
                  "studio/after-effects/preparing",
                  "studio/after-effects/delivery"
                ]
              }
            ]
          },
          {
            "group": "Organic",
            "pages": [
              "organic/overview",
              "organic/agent",
              "organic/calendar",
              "organic/analytics"
            ]
          },
          {
            "group": "Scale (paid media)",
            "pages": [
              "scale/overview",
              "scale/jaina",
              "scale/analytics",
              "scale/optimization",
              "scale/dco",
              "scale/approvals",
              "scale/campaign-canvas"
            ]
          },
          {
            "group": "Brand",
            "pages": [
              "brand/overview",
              "brand/readiness",
              "brand/spy"
            ]
          },
          {
            "group": "Account & settings",
            "pages": [
              "settings/roles",
              "settings/knowledge",
              "settings/billing"
            ]
          }
        ]
      },
      {
        "tab": "Resources",
        "groups": [
          {
            "group": "Resources",
            "pages": [
              "glossary",
              "changelog",
              "troubleshooting",
              "security"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Website",
          "href": "https://trycontinuum.ai",
          "icon": "globe"
        },
        {
          "anchor": "Support",
          "href": "mailto:support@trycontinuum.ai",
          "icon": "envelope"
        }
      ]
    }
  },
  "redirects": [
    { "source": "/platform/overview", "destination": "/concepts" },
    { "source": "/platform/campaigns", "destination": "/scale/overview" },
    { "source": "/platform/dco", "destination": "/scale/dco" },
    { "source": "/platform/brand-guardrails", "destination": "/brand/readiness" },
    { "source": "/platform/analytics", "destination": "/organic/analytics" },
    { "source": "/platform/socials", "destination": "/organic/overview" },
    { "source": "/studio/templates", "destination": "/studio/workflows" },
    { "source": "/studio/assets", "destination": "/studio/library" }
  ],
  "seo": {
    "indexing": "navigable"
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "feedback": {
    "thumbsRating": true,
    "suggestEdit": true
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://app.trycontinuum.ai"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/trycontinuum",
      "linkedin": "https://linkedin.com/company/trycontinuum"
    }
  }
}
