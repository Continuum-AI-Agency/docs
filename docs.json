            "group": "Reference",
            "pages": [
              "mcp/tools",
              "mcp/reference",
              "mcp/agent-brief"
            ]
          }
        ]
      },
      {
        "group": "Products",
        "pages": [
          {
            "group": "Creative+",
            "icon": "pen-ruler",
            "pages": [
              {
                "group": "AI Canvas",
                "pages": [
                  "canvas/overview",
                  "canvas/working-on-the-canvas",
                  {
                    "group": "Nodes",
                    "pages": [
                      "canvas/nodes/overview",
                      "canvas/nodes/image",
                      "canvas/nodes/video",
                      "canvas/nodes/text-audio-documents",
                      "canvas/nodes/actions",
                      "canvas/nodes/delivery"
                    ]
                  },
                  "canvas/models",
                  "canvas/workflows",
                  "canvas/pipelines",
                  "canvas/elements",
                  "canvas/skills-and-grounding"
                ]
              },
              "canvas/video-studio",
              "canvas/library",
              {
                "group": "Forge",
                "pages": [
                  "forge/overview",
                  {
                    "group": "After Effects delivery",
                    "pages": [
                      "forge/after-effects/overview",
                      "forge/after-effects/preparing",
                      "forge/after-effects/delivery"
                    ]
                  }
                ]
              },
              "brand/spy"
            ]
          },
          {
            "group": "Organic+",
            "icon": "seedling",
            "pages": [
              "organic/overview",
              "organic/agent",
              "organic/calendar",
              "organic/publishing",
              "organic/analytics"
            ]
          },
          {
            "group": "Performance+",
            "icon": "arrow-trend-up",
            "pages": [
              "performance/overview",
              "performance/jaina",
              "performance/optimizer",
              "performance/analytics",
              "performance/approvals"
            ]
          }
        ]
      },
      {
        "group": "Brand and account",
        "pages": [
          {
            "group": "Brand",
            "icon": "book",
            "pages": [
              "brand/overview",
              "brand/setup",
              "brand/readiness",
              "settings/knowledge"
            ]
          },
          {
            "group": "Account",
            "icon": "user-gear",
            "pages": [
              "integrations",
              "settings/roles",
              "settings/connections",
              "settings/billing",
              "security"
            ]
          }
        ]
      },
      {
        "group": "Resources",
        "pages": [
          "changelog",
          "troubleshooting"
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/platform/overview",
      "destination": "/concepts"
    },
    {
      "source": "/platform/campaigns",
      "destination": "/performance/overview"
    },
    {
      "source": "/platform/brand-guardrails",
      "destination": "/brand/readiness"
    },
    {
      "source": "/platform/analytics",
      "destination": "/organic/analytics"
    },
    {
      "source": "/platform/socials",
      "destination": "/organic/overview"
    },
    {
      "source": "/studio/templates",
      "destination": "/canvas/workflows"
    },
    {
      "source": "/studio/assets",
      "destination": "/canvas/library"
    },
    {
      "source": "/studio/overview",
      "destination": "/canvas/overview"
    },
    {
      "source": "/studio/canvas",
      "destination": "/canvas/working-on-the-canvas"
    },
    {
      "source": "/studio/workflows",
      "destination": "/canvas/workflows"
    },
    {
      "source": "/studio/library",
      "destination": "/canvas/library"
    },
    {
      "source": "/studio/after-effects/:slug*",
      "destination": "/forge/after-effects/:slug*"
    },
    {
      "source": "/scale/optimization",
      "destination": "/performance/optimizer"
    },
    {
      "source": "/scale/dco",
      "destination": "/performance/overview"
    },
    {
      "source": "/scale/campaign-canvas",
      "destination": "/performance/overview"
    },
    {
      "source": "/scale/:slug*",
      "destination": "/performance/:slug*"
    },
    {
      "source": "/platform/dco",
      "destination": "/performance/overview"
    },
    {
      "source": "/performance/dco",
      "destination": "/performance/overview"
    },
    {
      "source": "/performance/campaign-canvas",
      "destination": "/performance/overview"
    }
