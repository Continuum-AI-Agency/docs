{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "Continuum",
  "description": "Use Continuum from Claude, ChatGPT, or the app to plan, make, publish, and optimize on-brand creative across organic and paid.",
  "colors": {
    "primary": "#4C4EE4",
    "light": "#8696F5",
    "dark": "#4C4EE4"
  },
  "background": {
    "color": {
      "light": "#FBFCFD",
      "dark": "#0A0A0C"
    }
  },
  "appearance": {
    "default": "dark"
  },
  "fonts": {
    "heading": {
      "family": "Clash Display",
      "source": "/fonts/ClashDisplay-Variable.woff2",
      "format": "woff2",
      "weight": 600
    },
    "body": {
      "family": "Satoshi",
      "source": "/fonts/Satoshi-Variable.woff2",
      "format": "woff2",
      "weight": 500
    }
  },
  "errors": {
    "404": {
      "redirect": false,
      "title": "Page not found",
      "description": "This page moved or no longer exists. Search with **⌘K**, or start from the [quickstart](/quickstart) or [troubleshooting](/troubleshooting)."
    }
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "min-light",
        "dark": "min-dark"
      }
    }
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@trycontinuum.ai"
      },
      {
        "label": "Website",
        "href": "https://trycontinuum.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Continuum",
      "href": "https://app.trycontinuum.ai"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "quickstart",
          "concepts",
          "glossary"
        ]
      },
      {
        "group": "AI assistant (MCP)",
        "pages": [
          "mcp/overview",
          "mcp/connect",
          "mcp/how-to-ask",
          "mcp/recipes",
          {
            "group": "What you can do",
            "pages": [
              "mcp/use-cases/performance",
              "mcp/use-cases/brand",
              "mcp/use-cases/insights",
              "mcp/use-cases/social",
              "mcp/use-cases/ads",
              "mcp/use-cases/creative",
              "mcp/use-cases/video",
              "mcp/use-cases/templates"
