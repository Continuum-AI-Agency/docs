{
  "name": "forge_query",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "templates",
          "template",
          "sets",
          "set",
          "set_revisions",
          "destinations",
          "jobs",
          "job",
          "batch",
          "scenes",
          "set_diff",
          "template_tree",
          "template_layers",
          "template_revision",
          "template_diff",
          "template_run",
          "sources"
        ]
      },
      "templateKey": {
        "type": "string",
        "minLength": 1
      },
      "bindingId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "setId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "jobId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "status": {
        "type": "string",
        "enum": [
          "submitting",
          "queued",
          "rendering",
          "finished",
          "failed"
        ]
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50
      },
      "batchId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "waitSeconds": {
        "type": "integer",
        "minimum": 0,
        "maximum": 55
      },
      "rowIds": {
        "minItems": 2,
        "maxItems": 2,
        "type": "array",
        "items": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "fromRevision": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "toRevision": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "assetId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "revisionId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "toRevisionId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "action": {
            "type": "string",
            "enum": [
              "templates",
              "template",
              "sets",
              "set",
              "set_revisions",
              "destinations",
              "jobs",
              "job",
              "batch",
              "scenes",
              "set_diff",
              "template_tree",
              "template_layers",
              "template_revision",
              "template_diff",
              "template_run",
              "sources"
            ]
          },
          "result": {}
        },
        "required": [
          "status",
          "action",
          "result"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "needs_brand"
          },
          "fix": {
            "type": "string",
            "const": "brands_select"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "fix",
          "message"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "needs_integration"
          },
          "platform": {
            "type": "string"
          },
          "fix": {
            "type": "string",
            "const": "integrations_connect"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "platform",
          "fix",
          "message"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "needs_reauth"
          },
          "platform": {
            "type": "string"
          },
          "fix": {
            "type": "string",
            "const": "integrations_connect"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "platform",
          "fix",
          "message"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "needs_role"
          },
          "required_role": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "required_role",
          "message"
        ],
        "additionalProperties": false
      }
    ]
  }
}
